mmand`` runs the job in a separate thread with its own event loop, but\nthe ``new_log_evt`` waiters live in the daemon loop. ``asyncio.Event.set()`` is\nnot thread-safe, so without hopping back onto the daemon loop the terminal DONE\nnotification is lost and ``ws_poll_info`` hangs forever (the desktop app's\n&quot;finalizing&quot; step never completes and the connection eventually drops).\n``from_threadpool`` mimics sync routes (``/update/start``), which call\n``run_command`` from FastAPI's threadpool, with no running loop.\n</code></pre>\n","environment":"default","setup":[{"id":"a4201b62d6933380bcaaba443fd113f3","type":"before","name":"event_loop_policy","status":"passed","steps":[],"duration":1},{"id":"3d313f97ecd25d593bc6ec3a01b2b732","type":"before","name":"tmp_path_factory","status":"passed","steps":[],"duration":0},{"id":"47c3fcd68a187bfd01bc5566392e3571","type":"before","name":"monkeypatch","status":"passed","steps":[],"duration":0},{"id":"61edbbeec8d7c6b44b0ccc407d6626a7","type":"before","name":"_isolated_hf_credentials","status":"passed","steps":[],"duration":0},{"id":"810afae1cd3b94be629d8c69e63b7663","type":"before","name":"_no_telemetry","status":"passed","steps":[],"duration":0},{"id":"1fbcbcd7548e24756a33e604c7f6bc6b","type":"before","name":"_function_scoped_runner","status":"passed","steps":[],"duration":0}],"teardown":[{"id":"ba2d62e71eb18ddd20b436e269ed22e8","type":"after","name":"_function_scoped_runner::0","status":"passed","steps":[],"duration":0},{"id":"a0cce7ea55a7d8ae97fce878a7d4f51f","type":"after","name":"monkeypatch::0","status":"passed","steps":[],"duration":0}],"history":[{"id":"3725992928e9d617c3bcaac7d0c6420f","name":"test_ws_poll_info_receives_terminal_status_from_worker_thread[False]","fullName":"tests.unit_tests.test_bg_job_register#test_ws_poll_info_receives_terminal_status_from_worker_thread","environment":"default","status":"passed","retries":[],"start":1794932669805,"stop":1794932669909,"duration":104,"labels":[{"name":"tag","va